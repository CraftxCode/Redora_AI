# ── Redora AI environment ───────────────────────────────────────────
# Copy to `.env`. Secrets live ONLY here (server side) — never in React.

# Pollinations (https://enter.pollinations.ai). The key is optional for the
# anonymous free tier but recommended: it gives better rate limits.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
POLLINATIONS_API_URL=https://gen.pollinations.ai/v1/chat/completions

# Server
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated origins allowed for CORS (only needed if the web app is hosted elsewhere)
CORS_ORIGINS=
TRUST_PROXY=false

# Free-tier protection
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS=650
RATE_LIMIT_PER_MINUTE=20

# Client (optional) — leave empty to use the Vite proxy / same origin
VITE_API_BASE_URL=
